# Frontend: only a public deployment URL goes here. Never put keys in VITE_*.
# Convex CLI generates .env.local when the isolated backend starts.
VITE_CONVEX_URL=http://127.0.0.1:4212

# Backend REFERENCE ONLY: these are NOT loaded by Vite or Convex from this file.
# Set them in the backend via operator tools / convex env.
HOUSE_ENVIRONMENT=local-development
HOUSE_MODE=mock
HOUSE_LLM_PAID_ENABLED=0
HOUSE_LLM_AUTONOMOUS_ENABLED=0
HOUSE_LLM_UNLIMITED_DEV=0
HOUSE_LLM_TEST_ONLY=0
HOUSE_STAGE2_TOOLS=0
HOUSE_RESET_TEST_TOOLS=0
HOUSE_COGNITION_STRUCTURED=0
HOUSE_LLM_BASE_URL=https://provider.example.invalid/v1
HOUSE_LLM_API_KEY=REPLACE_WITH_YOUR_OWN_KEY_ON_BACKEND_ONLY
HOUSE_LLM_MODEL=REPLACE_WITH_PROVIDER_MODEL_ID
HOUSE_LLM_PROTOCOL=openai-chat
HOUSE_LLM_ENDPOINT_PATH=/chat/completions
HOUSE_LLM_PRICE_CONFIRMED=0
HOUSE_LLM_USAGE_TRUST=untrusted
HOUSE_LLM_BILLING_MODE=unknown
HOUSE_LLM_INPUT_CNY_PER_MILLION=REPLACE_WITH_VERIFIED_PRICE
HOUSE_LLM_OUTPUT_CNY_PER_MILLION=REPLACE_WITH_VERIFIED_PRICE
HOUSE_LLM_DAILY_CNY=1
HOUSE_LLM_MONTHLY_CNY=30
HOUSE_LLM_MAX_OUTPUT_TOKENS=2048
HOUSE_LLM_TIMEOUT_MS=60000
HOUSE_LLM_DAILY_CALLS=120
HOUSE_LLM_MONTHLY_CALLS=3000
# JWT_PRIVATE_KEY and JWKS must be generated per installation; do not copy examples.
